<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="theme-color" content="#f8f8fb">
        <title>{% block title %}Votre bibliothèque{% endblock %} · Mosaik</title>
        <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='18' fill='%236b55d9'/%3E%3Crect x='14' y='14' width='15' height='15' rx='4' fill='white'/%3E%3Crect x='35' y='14' width='15' height='15' rx='4' fill='%23c9bbff'/%3E%3Crect x='14' y='35' width='15' height='15' rx='4' fill='%23c9bbff'/%3E%3Crect x='35' y='35' width='15' height='15' rx='4' fill='white'/%3E%3C/svg%3E">
        {% block stylesheets %}{{ reprise_entry_link_tags('app') }}{% endblock %}
        {% block javascripts %}{{ reprise_entry_script_tags('app') }}{% endblock %}
    </head>
    <body>
        <svg class="icon-sprite" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <symbol id="icon-grid" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></symbol>
            <symbol id="icon-inbox" viewBox="0 0 24 24"><path d="M4 4h16l2 11v4a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-4L4 4Z"/><path d="M2 15h6l2 3h4l2-3h6"/></symbol>
            <symbol id="icon-folder" viewBox="0 0 24 24"><path d="M3 19V5a2 2 0 0 1 2-2h5l2 3h7a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/></symbol>
            <symbol id="icon-link" viewBox="0 0 24 24"><path d="M10 13.5a5 5 0 0 0 7.1.1l2.4-2.4a5 5 0 0 0-7.1-7.1L11 5.5"/><path d="M14 10.5a5 5 0 0 0-7.1-.1l-2.4 2.4a5 5 0 0 0 7.1 7.1l1.4-1.4"/></symbol>
            <symbol id="icon-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
            <symbol id="icon-arrow-up-right" viewBox="0 0 24 24"><path d="M7 17 17 7M7 7h10v10"/></symbol>
            <symbol id="icon-arrow-left" viewBox="0 0 24 24"><path d="m11 19-7-7 7-7M4 12h16"/></symbol>
            <symbol id="icon-chevron-right" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></symbol>
            <symbol id="icon-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></symbol>
            <symbol id="icon-sparkle" viewBox="0 0 24 24"><path d="m12 3 1.7 5.3L19 10l-5.3 1.7L12 17l-1.7-5.3L5 10l5.3-1.7L12 3ZM19 15l.7 2.3L22 18l-2.3.7L19 21l-.7-2.3L16 18l2.3-.7L19 15Z"/></symbol>
        </svg>

        <div class="app-shell">
            {% include 'library/_sidebar.html.twig' %}

            <div class="workspace">
                <header class="topbar">
                    <nav class="breadcrumb" aria-label="Vous êtes ici">
                        <ul>
                            <li>
                                <a href="{{ path('app_library') }}">Bibliothèque</a>
                            </li>
                            <li>
                                <a href="#">{% block breadcrumb %}{{ current_folder ? current_folder.path : (view == 'uncategorized' ? 'Sans dossier' : 'Tous les liens') }}{% endblock %}</a>
                            </li>
                        </ul>
                    </nav>
                    <div class="flex gap-4">
                        <a class="btn btn--outline-primary btn--icon" href="{{ path('app_folder_new', current_folder ? {parent: current_folder.id} : {}) }}">
                            <svg class="icon mr-4" aria-hidden="true"><use href="#icon-folder"/></svg>
                            <span>Nouveau dossier</span>
                        </a>
                        <a class="btn btn--primary btn--icon" href="{{ path('app_bookmark_new', current_folder ? {folder: current_folder.id} : {}) }}">
                            <svg class="icon" aria-hidden="true"><use href="#icon-plus"/></svg>
                            <span>Ajouter un lien</span>
                        </a>
                    </div>
                </header>

                <main id="main-content" class="main-content">
                    {% for message in app.flashes('success') %}
                        <div class="alert alert--success flash-message" role="status">
                            <svg class="icon" aria-hidden="true"><use href="#icon-check"/></svg>
                            {{ message }}
                        </div>
                    {% endfor %}

                    {% block body %}{% endblock %}

                    <footer class="p-2">
                        <span>Mosaki v0.1</span>
                    </footer>
                </main>
            </div>
        </div>
    </body>
</html>
